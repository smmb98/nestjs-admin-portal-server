/**
 * Base TypeScript Configuration
 * 
 * This is the root configuration file that serves as the base for all other
 * TypeScript configurations in this project. It contains shared compiler options
 * that are common across development, build, and tooling environments.
 * 
 * Other configs extend this file:
 * - tsconfig.app.json (development type-checking)
 * - tsconfig.build.json (production build)
 * - tsconfig.node.json (Vite tooling)
 */
{
  "compilerOptions": {
    /* Base Configuration */
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "skipLibCheck": true,

    /* Path Mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Decorators (NestJS requirement) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* JSX (for React components if any) */
    "jsx": "react-jsx"
  }
}
